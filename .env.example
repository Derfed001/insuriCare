# ---- WhatsApp Cloud API (Meta) ----
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=choose-any-long-random-string
WA_APP_SECRET=
# Optional approved templates (needed to message people outside the 24-hour window)
WA_TEMPLATE_ALERT=
WA_TEMPLATE_CALLBACK=
WA_TEMPLATE_LANG=en

# ---- Africa's Talking (SMS + phone calls) ----
AT_USERNAME=
AT_API_KEY=
# Any long random string. It is added to your callback URLs as ?key=...
AT_WEBHOOK_SECRET=
# Optional: your approved sender ID / shortcode for SMS replies
AT_SMS_FROM=
# Your Africa's Talking voice number (shown as caller ID when transferring calls to you)
AT_VOICE_NUMBER=
# Your own mobile in +254 format. Pressing 0 on the phone menu rings this number in office hours
OWNER_PHONE=+2547XXXXXXXX
# Set to 1 when this voice number is ONLY the target of your phone's call forwarding (busy / unanswered / unreachable).
# Callers then skip the menu and the assistant answers straight away. See docs/CALL_FORWARDING.md
CALL_FORWARDED=
# Your first name, used in the greeting: "<name> is not available to take your call right now"
OWNER_NAME=
# 0 = do not text you a short summary after each forwarded call
FORWARD_SUMMARY=
# Text-to-speech voice. Check Africa's Talking's Voice docs for the voices on your account
AT_TTS_VOICE=woman
# Set to 1 to use the Africa's Talking sandbox for SMS testing
AT_SANDBOX=
# Optional overrides
PUBLIC_BASE_URL=
OFFICE_HOURS_JSON=

# ---- Where YOU get alerted ----
# Alerts reach your phone by SMS (via Africa's Talking) using OWNER_PHONE above. Set ALERT_SMS=0 to turn that off.
OWNER_WHATSAPP=
# Telegram is optional and not needed
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- The assistant: use ONE of these ----
# A) your own assistant service (the voice/text agent). POST JSON in, {reply, escalate?, urgency?, reason?, audio_url?} out
ASSISTANT_URL=
ASSISTANT_TOKEN=
# B) Gemini directly (free tier)
GEMINI_API_KEY=
# Leave EMPTY. The code picks a working model itself (gemini-2.5-flash was shut down on 16 Oct 2026).
# Only set this if you want to force a specific current model name from AI Studio.
GEMINI_MODEL=

# ---- Website chatbot (uses GEMINI_API_KEY above) ----
# Optional model just for the chatbot (it uses Google Search grounding). Leave empty.
CHAT_MODEL=
# Messages allowed per visitor per 10 minutes, and per day for the whole site (protects your Gemini bill)
CHAT_RATE_LIMIT=20
CHAT_DAILY_LIMIT=800

# ---- Memory (recommended; free Upstash Redis) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Hours the AI stays quiet after it hands a client to you
TAKEOVER_HOURS=6
