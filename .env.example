# ---- WhatsApp Cloud API (Meta) ----
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=choose-any-long-random-string
WA_APP_SECRET=
# Optional approved templates (needed to message people outside the 24-hour window)
WA_TEMPLATE_ALERT=
WA_TEMPLATE_CALLBACK=
WA_TEMPLATE_LANG=en

# ---- Where YOU get alerted ----
OWNER_WHATSAPP=2547XXXXXXXX
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- The assistant: use ONE of these ----
# A) your own assistant service (the voice/text agent). POST JSON in, {reply, escalate?, urgency?, reason?, audio_url?} out
ASSISTANT_URL=
ASSISTANT_TOKEN=
# B) Gemini directly (free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Memory (recommended; free Upstash Redis) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Hours the AI stays quiet after it hands a client to you
TAKEOVER_HOURS=6
